# Copy to .env and adjust. NEVER commit .env.
# All values below are for LOCAL DEVELOPMENT ONLY.

# ---------- Django ----------
DJANGO_SECRET_KEY=dev-only-change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Exact frontend origins (comma separated, no wildcard). Also used for the S3 bucket CORS rule.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Postgres ----------
POSTGRES_DB=avatar
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Silo (local S3) ----------
# Pin a specific release tag once you have picked one (see https://github.com/pgsty/silo).
SILO_IMAGE=pgsty/silo:latest
# Root credentials: used only by setup scripts and the console. The app never uses them.
SILO_ROOT_USER=silo-admin
SILO_ROOT_PASSWORD=silo-admin-secret-change-me

# ---------- S3 settings used by the app ----------
AWS_STORAGE_BUCKET_NAME=avatars-dev
AWS_REGION=us-east-1
# Endpoint the backend container uses (Docker network)
AWS_S3_ENDPOINT_URL=http://silo:9000
# Endpoint the BROWSER can reach; used only to sign presigned POSTs
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_ADDRESSING_STYLE=path
# The application's own access key. `make app-key` creates it in Silo with these values.
AWS_ACCESS_KEY_ID=avatar-app
AWS_SECRET_ACCESS_KEY=avatar-app-secret-key-dev

# ---------- CDN (Varnish) ----------
# Must be letters and digits only (it is substituted into the VCL with sed).
ORIGIN_VERIFY_SECRET=devoriginsecret123
VARNISH_SIZE=64m
AVATAR_BASE_URL=http://localhost:8080
INVALIDATION_BACKEND=varnish
VARNISH_BAN_URL=http://varnish:80

# ---------- Email (Mailpit) ----------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
FRONTEND_BASE_URL=http://localhost:5173

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000
VITE_AVATAR_BASE_URL=http://localhost:8080
