# ---------- Django ----------
DJANGO_SECRET_KEY=dev-only-change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Browser origin (now served through the main Nginx)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---------- Postgres ----------
POSTGRES_DB=avatar
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Silo ----------
SILO_IMAGE=pgsty/silo:RELEASE.2026-10-26T00-00-00Z
SILO_ROOT_USER=silo-admin
SILO_ROOT_PASSWORD=change-this-local-secret

# ---------- S3 settings used by the app ----------
AWS_STORAGE_BUCKET_NAME=avatars-dev
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://silo:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=avatar-app
AWS_SECRET_ACCESS_KEY=avatar-app-secret-key-dev

# ---------- CDN ----------
ORIGIN_VERIFY_SECRET=devoriginsecret123
VARNISH_SIZE=64m
AVATAR_BASE_URL=
INVALIDATION_BACKEND=varnish
VARNISH_BAN_URL=http://varnish:80

# ---------- Email ----------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
FRONTEND_BASE_URL=http://localhost:8080

# ---------- Frontend ----------
VITE_API_URL=
VITE_AVATAR_BASE_URL=
